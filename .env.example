# Hedes Studio Environment Variables
# API Keys (optional - can also be configured directly in Settings UI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_BASE_URL=http://localhost:11434

# Public AWS Cognito / API Gateway values for the optional HEDES Cloud Sync beta.
# These are identifiers, not secrets. Never put AWS keys or provider API keys here.
VITE_HEDES_CLOUD_API_URL=
VITE_HEDES_CLOUD_USER_POOL_ID=
VITE_HEDES_CLOUD_CLIENT_ID=
