{
  "name": "hedes-studio",
  "description": "Hedes Studio — Autonomous Multi-Agent AI Development Environment with 100-Bot Hive Mind",
  "author": "Aditya",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "build/electron/main/index.mjs",
  "version": "1.1.0",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --port 5174",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "tsc",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs tests/checkpoints.test.mjs tests/runtime-storage.test.mjs tests/core.test.mjs",
    "test:integration": "node scripts/run-tests.mjs tests/persistence-backup.test.mjs tests/real-council.test.mjs tests/custom-models.test.mjs",
    "test:security": "node scripts/run-tests.mjs tests/security-session-auth.test.mjs tests/core.test.mjs tests/plan3-failure-scenarios.test.mjs",
    "verify:release": "npm run typecheck && npm run test",
    "mcp:serve": "node mcp/hedes-server.mjs",
    "electron:dev": "npm run electron:build:deps && electron .",
    "electron:build:main": "vite build --config ./electron/main/vite.config.ts",
    "electron:build:preload": "vite build --config ./electron/preload/vite.config.ts",
    "electron:build:deps": "concurrently \"npm run electron:build:main\" \"npm run electron:build:preload\" --kill-others-on-fail",
    "electron:build:renderer": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" react-router build --config vite-electron.config.ts",
    "electron:build:mac": "rimraf dist && npm run electron:build:renderer && npm run electron:build:deps && electron-builder --mac",
    "electron:build:win": "rimraf dist && npm run electron:build:renderer && npm run electron:build:deps && electron-builder --win",
    "electron:build:dist": "rimraf dist && npm run electron:build:renderer && npm run electron:build:deps && electron-builder --mwl"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "2.0.107",
    "@ai-sdk/google": "2.0.100",
    "@ai-sdk/openai": "2.0.132",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@nanostores/react": "^0.7.3",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@types/jszip": "^3.4.1",
    "@uiw/codemirror-theme-vscode": "^4.23.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "5.0.270",
    "animejs": "^4.5.0",
    "clsx": "^2.1.0",
    "dotenv": "^16.4.7",
    "electron-log": "^5.4.4",
    "electron-store": "10.1.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.12.0",
    "idb": "^8.0.0",
    "isbot": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.485.0",
    "mime": "^4.1.0",
    "nanostores": "^0.10.3",
    "path-browserify": "^1.0.1",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router": "7.18.4",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.2.1",
    "yauzl": "^3.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@react-router/fs-routes": "7.18.4",
    "@types/node": "^20.17.0",
    "@types/path-browserify": "^1.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "^3.4.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^25.1.8",
    "playwright": "1.58.2",
    "postcss": "^8.4.49",
    "rimraf": "^5.0.10",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-tsconfig-paths": "^4.3.2",
    "wait-on": "^9.1.0"
  }
}
