{
  "name": "hedes-studio",
  "description": "Hedes Studio — Autonomous Multi-Agent AI Development Environment with 100-Bot Hive Mind",
  "author": "Aditya",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev --port 5174",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on tcp:5174 && electron electron/main/index.js\"",
    "electron:build:main": "vite build --config ./electron/main/vite.config.ts",
    "electron:build:preload": "vite build --config ./electron/preload/vite.config.ts",
    "electron:build:deps": "concurrently \"npm run electron:build:main\" \"npm run electron:build:preload\" --kill-others-on-fail",
    "electron:build:renderer": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" remix vite:build --config vite-electron.config.ts",
    "electron:build:mac": "rm -rf dist && npm run electron:build:renderer && npm run electron:build:deps && electron-builder --mac",
    "electron:build:win": "rm -rf dist && npm run electron:build:renderer && npm run electron:build:deps && electron-builder --win",
    "electron:build:dist": "rm -rf dist && npm run electron:build:renderer && npm run electron:build:deps && electron-builder --mwl"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "0.0.39",
    "@ai-sdk/google": "0.0.52",
    "@ai-sdk/openai": "1.1.2",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@nanostores/react": "^0.7.3",
    "@openrouter/ai-sdk-provider": "^0.0.5",
    "@remix-run/node": "^2.15.2",
    "@remix-run/react": "^2.15.2",
    "@remix-run/serve": "^2.15.2",
    "@types/jszip": "^3.4.1",
    "@uiw/codemirror-theme-vscode": "^4.23.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "4.1.2",
    "clsx": "^2.1.0",
    "dotenv": "^16.4.7",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.12.0",
    "idb": "^8.0.0",
    "isbot": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.485.0",
    "mime": "^4.1.0",
    "nanostores": "^0.10.3",
    "ollama-ai-provider": "^0.15.2",
    "path-browserify": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.2",
    "@types/node": "^20.17.0",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "rimraf": "^5.0.10",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-tsconfig-paths": "^4.3.2",
    "wait-on": "^9.1.0"
  }
}
